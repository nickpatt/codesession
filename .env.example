# Copy to .env and adjust as needed. All values have sensible defaults.

# --- session-server ---
PORT=8080
CORS_ORIGIN=*
DATA_DIR=./data
PERSIST_INTERVAL_MS=5000
SWEEP_INTERVAL_MS=60000
SESSION_TTL_MS=86400000   # 24 hours
EXEC_URL=http://localhost:9090
AGENT_URL=http://localhost:7070

# --- execution-service (Phase 2) ---
# PORT=9090   # (its own PORT env)

# --- agent-server (Phase 3) ---
AGENT_PORT=7070
SESSION_WS_URL=ws://localhost:8080/ws
LLM_PROVIDER=mock            # or "anthropic"
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-3-5-sonnet-latest
AGENT_MAX_ITERATIONS=5
AGENT_MAX_EXECUTIONS=8
AGENT_MAX_RUNTIME_MS=120000
AGENT_MAX_CONTEXT_TOKENS=20000
