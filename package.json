{
  "name": "codesession",
  "private": true,
  "version": "0.1.0",
  "description": "Real-time collaborative coding platform with live code execution.",
  "workspaces": [
    "packages/shared",
    "packages/session-server",
    "packages/agent-server",
    "packages/web"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @codesession/session-server & npm run dev --workspace @codesession/web",
    "dev:server": "npm run dev --workspace @codesession/session-server",
    "dev:web": "npm run dev --workspace @codesession/web",
    "dev:agent": "npm run dev --workspace @codesession/agent-server",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "license": "MIT",
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.21.5": true
  }
}
